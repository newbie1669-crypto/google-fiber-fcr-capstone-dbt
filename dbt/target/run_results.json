_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T03:17:30.066774Z", "completed_at": "2026-07-10T03:17:30.085282Z"}, {"name": "execute", "started_at": "2026-07-10T03:17:30.086285Z", "completed_at": "2026-07-10T03:17:30.086285Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.09414029121398926, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.google_fiber.mart_fiber_fcr", "compiled": true, "compiled_code": "-- models/marts/mart_fiber_fcr.sql\n-- Final mart: Union all markets and calculate FCR metrics\n\nWITH combined AS (\n    SELECT * FROM `gbi-test`.`fiber`.`stg_market_1`\n    UNION ALL\n    SELECT * FROM `gbi-test`.`fiber`.`stg_market_2`\n    UNION ALL\n    SELECT * FROM `gbi-test`.`fiber`.`stg_market_3`\n),\n\n-- DATA-QUALITY GATE: drop rows that cannot produce a FCR value.\n-- In staging, a raw \"null\" in contacts_n is COALESCE'd to 0. For the\n-- follow-up columns 0 = \"no follow-up\" (correct), but for contacts_n\n-- (first contacts = the FCR denominator) a 0 means the first-contact\n-- count is missing/unknown, NOT \"zero contacts\" \u2014 some of those rows\n-- even have follow-up contacts, which is impossible with 0 originals.\n-- SAFE_DIVIDE by a 0 denominator returns NULL, so FCR \"was not\n-- calculated\" for those rows. They are excluded here.\n\nvalid AS (\n    SELECT * FROM combined\n    WHERE contacts_n > 0\n),\n\nwith_metrics AS (\n    SELECT\n        date_created,\n        new_type,\n        new_market,\n        contacts_n,\n        contacts_n_1,\n        contacts_n_2,\n        contacts_n_3,\n        contacts_n_4,\n        contacts_n_5,\n        contacts_n_6,\n        contacts_n_7,\n\n        (contacts_n_1 + contacts_n_2 + contacts_n_3 +\n         contacts_n_4 + contacts_n_5 + contacts_n_6 + contacts_n_7) AS total_repeat_contacts,\n\n        -- Day 1 FCR Rate\n        -- Use GREATEST(..., 0) to clamp repeat contacts that exceed first contacts\n        -- (one case may be re-contacted many times), which would make FCR rate < 0%\n        -- If repeats exceed first contacts that day, FCR is cut to 0% since the issue wasn't resolved.\n\n        SAFE_DIVIDE(\n            GREATEST(contacts_n - contacts_n_1, 0),\n            contacts_n\n        ) AS fcr_day1_rate,\n\n        -- 7-day FCR Rate\n        SAFE_DIVIDE(\n            GREATEST(contacts_n - (contacts_n_1 + contacts_n_2 + contacts_n_3 + \n                                   contacts_n_4 + contacts_n_5 + contacts_n_6 + contacts_n_7), 0),\n            contacts_n\n        ) AS fcr_7day_rate,\n\n        -- Repeat rate per day\n        SAFE_DIVIDE(contacts_n_1, contacts_n) AS repeat_rate_day1,\n        SAFE_DIVIDE(contacts_n_2, contacts_n) AS repeat_rate_day2,\n        SAFE_DIVIDE(contacts_n_3, contacts_n) AS repeat_rate_day3,\n        SAFE_DIVIDE(contacts_n_4, contacts_n) AS repeat_rate_day4,\n        SAFE_DIVIDE(contacts_n_5, contacts_n) AS repeat_rate_day5,\n        SAFE_DIVIDE(contacts_n_6, contacts_n) AS repeat_rate_day6,\n        SAFE_DIVIDE(contacts_n_7, contacts_n) AS repeat_rate_day7,\n\n        -- Metadata\n        CURRENT_TIMESTAMP() AS dbt_updated_at\n\n    FROM valid\n)\n\nSELECT * FROM with_metrics", "relation_name": "`gbi-test`.`fiber`.`mart_fiber_fcr`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T03:17:30.066774Z", "completed_at": "2026-07-10T03:17:30.084321Z"}, {"name": "execute", "started_at": "2026-07-10T03:17:30.085282Z", "completed_at": "2026-07-10T03:17:30.085282Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.16830968856811523, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_1_new_type.ef1c422aa5", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect new_type\nfrom `gbi-test`.`fiber`.`stg_market_1`\nwhere new_type is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T03:17:29.996420Z", "completed_at": "2026-07-10T03:17:30.121773Z"}, {"name": "execute", "started_at": "2026-07-10T03:17:30.121773Z", "completed_at": "2026-07-10T03:17:30.121773Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 0.2508554458618164, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_1_new_market.819377fe1e", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect new_market\nfrom `gbi-test`.`fiber`.`stg_market_1`\nwhere new_market is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T03:17:30.066774Z", "completed_at": "2026-07-10T03:17:30.158895Z"}, {"name": "execute", "started_at": "2026-07-10T03:17:30.159816Z", "completed_at": "2026-07-10T03:17:30.159816Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.17951035499572754, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.dbt_utils_expression_is_true_stg_market_3_contacts_n___0.07f8f285ec", "compiled": true, "compiled_code": "\n\n\n\nselect\n    1\nfrom `gbi-test`.`fiber`.`stg_market_3`\n\nwhere not(contacts_n >= 0)\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T03:17:30.162816Z", "completed_at": "2026-07-10T03:17:30.247305Z"}, {"name": "execute", "started_at": "2026-07-10T03:17:30.253371Z", "completed_at": "2026-07-10T03:17:30.253371Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.1414170265197754, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_3_contacts_n.1758f1585f", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect contacts_n\nfrom `gbi-test`.`fiber`.`stg_market_3`\nwhere contacts_n is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"nam