ull, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-14T22:11:50.386344Z", "completed_at": "2026-07-14T22:11:50.418935Z"}, {"name": "execute", "started_at": "2026-07-14T22:11:50.427380Z", "completed_at": "2026-07-14T22:11:50.427393Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.04963088035583496, "adapter_response": {}, "message": null, "failures": null, "unique_id": "analysis.google_fiber.dq_summary_report", "compiled": true, "compiled_code": "-- dbt compile --select dq_summary_report\n-- copy compiled SQL -> run on BigQuery Console\n\n\n\nWITH base AS (\n    SELECT * FROM `gbi-test`.`dbt_prod`.`mart_fiber_fcr`\n)\n\nSELECT\n    -- \u2500\u2500 Row count \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    COUNT(*)                                    AS total_rows,\n\n    -- \u2500\u2500 NULL checks \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    COUNTIF(date_created IS NULL)               AS null_date_created,\n    COUNTIF(new_type IS NULL)                   AS null_new_type,\n    COUNTIF(new_market IS NULL)                 AS null_new_market,\n    COUNTIF(contacts_n IS NULL)                 AS null_contacts_n,\n\n    -- \u2500\u2500 Negative checks \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    COUNTIF(contacts_n < 0)                     AS neg_contacts_n,\n    COUNTIF(contacts_n_1 < 0)                   AS neg_contacts_n_1,\n    COUNTIF(contacts_n_2 < 0)                   AS neg_contacts_n_2,\n    COUNTI