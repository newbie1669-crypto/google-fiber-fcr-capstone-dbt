": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-13T12:46:30.951755Z", "completed_at": "2026-07-13T12:46:30.968792Z"}, {"name": "execute", "started_at": "2026-07-13T12:46:30.978124Z", "completed_at": "2026-07-13T12:46:30.978134Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 0.03736472129821777, "adapter_response": {}, "message": null, "failures": null, "unique_id": "analysis.google_fiber.dq_summary_report", "compiled": true, "compiled_code": "-- dbt compile --select dq_summary_report\n-- copy compiled SQL -> run on BigQuery Console\n\n\n\nWITH base AS (\n    SELECT * FROM `gbi-test`.`dbt_prod`.`mart_fiber_fcr`\n)\n\nSELECT\n    -- \u2500\u2500 Row count \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    COUNT(*)                                    AS total_rows,\n\n    -- \u2500\u2500 NULL checks \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    COUNTIF(date_created IS NULL)               AS null_date_created,\n    COUNTIF(new_type IS NULL)                   AS null_new_type,\n    COUNTIF(new_market IS NULL)                 AS null_new_market,\n    COUNTIF(contacts_n IS NULL)                 AS null_contacts_n,\n\n    -- \u2500\u2500 Negative checks \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    COUNTIF(contacts_n < 0)                     AS neg_contacts_n,\n    COUNTIF(contacts_n_1 < 0)                   AS neg_contacts_n_1,\n    COUNTIF(contacts_n_2 < 0)                   AS neg_contacts_n_2,\n    COUNTIF(contacts_n_3 < 0)                   AS neg_contacts_n_3,\n    COUNTIF(contacts_n_4 < 0)                   AS neg_contacts_n_4,\n    COUNTIF(contacts_n_5 < 0)                   AS neg_contacts_n_5,\n    COUNTIF(contacts_n_6 < 0)                   AS neg_contacts_n_6,\n    COUNTIF(contacts_n_7 < 0)                   AS neg_contacts_n_7,\n\n    -- \u2500\u2500 Date range \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    MIN(date_created)                           AS min_date,\n    MAX(date_created)                           AS max_date,\n    COUNT(DISTINCT date_created)                AS distinct_dates,\n\n    -- \u2500\u2500 Cardinality \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    COUNT(DISTINCT new_type)                    AS distinct_types,\n    COUNT(DISTINCT new_market)                  AS distinct_markets,\n\n    -- \u2500\u2500 Future date check \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    COUNTIF(date_created > CURRENT_DATE())      AS future_dates,\n\n    -- \u2500\u2500 Metadata \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    CURRENT_TIMESTAMP()                         AS report_generated_at\n\nFROM base\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-13T12:46:30.956081Z", "completed_at": "2026-07-13