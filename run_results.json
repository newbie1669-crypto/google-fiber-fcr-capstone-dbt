_1 AS INT64), 0) AS contacts_n_1,\n        COALESCE(SAFE_CAST(contacts_n_2 AS INT64), 0) AS contacts_n_2,\n        COALESCE(SAFE_CAST(contacts_n_3 AS INT64), 0) AS contacts_n_3,\n        COALESCE(SAFE_CAST(contacts_n_4 AS INT64), 0) AS contacts_n_4,\n        COALESCE(SAFE_CAST(contacts_n_5 AS INT64), 0) AS contacts_n_5,\n        COALESCE(SAFE_CAST(contacts_n_6 AS INT64), 0) AS contacts_n_6,\n        COALESCE(SAFE_CAST(contacts_n_7 AS INT64), 0) AS contacts_n_7,\n        TRIM(UPPER(new_type)) AS new_type,\n        TRIM(UPPER(new_market)) AS new_market\n    FROM source\n)\n\nSELECT * FROM cleaned", "relation_name": "`gbi-test`.`dbt_prod`.`stg_market_2`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T19:58:09.073206Z", "completed_at": "2026-07-10T19:58:09.095324Z"}, {"name": "execute", "started_at": "2026-07-10T19:58:09.110747Z", "completed_at": "2026-07-10T19:58:09.110758Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 0.03882002830505371, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.dbt_utils_expression_is_true_stg_market_1_contacts_n___0.30f91f99d2", "compiled": true, "compiled_code": "\n\n\n\nselect\n    1\nfrom `gbi-test`.`dbt_prod`.`stg_market_1`\n\nwhere not(contacts_n >= 0)\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T19:58:09.095910Z", "completed_at": "2026-07-10T19:58:09.121415Z"}, {"name": "execute", "started_at": "2026-07-10T19:58:09.137917Z", "completed_at": "2026-07-10T19:58:09.137929Z"}], "thread_id": "Thread-7 (worker)", "execution_time": 0.05354785919189453, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_1_contacts_n.9230153d9e", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect contacts_n\nfrom `gbi-test`.`dbt_prod`.`stg_market_1`\nwhere contacts_n is null\n\n\n", "relation_name":