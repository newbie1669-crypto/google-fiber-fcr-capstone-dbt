: {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_2_contacts_n.05421176c1", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect contacts_n\nfrom `gbi-test`.`dbt_prod`.`stg_market_2`\nwhere contacts_n is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-24T22:11:00.999249Z", "completed_at": "2026-08-24T22:11:01.013984Z"}, {"name": "execute", "started_at": "2026-08-24T22:11:01.026415Z", "completed_at": "2026-08-24T22:11:01.026423Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 0.03409385681152344, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_2_new_market.4d0b681bb5", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect new_market\nfrom `gbi-test`.`dbt_prod`.`stg_market_2`\nwhere new_market is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-24T22:11:01.006238Z", "completed_at": "2026-08-24T22:11:01.026002Z"}, {"name": "execute", "started_at": "2026-08-24T22:11:01.029247Z", "completed_at": "2026-08-24T22:11:01.029256Z"}], "thread_id": "Thread-7 (worker)", "execution_time": 0.03524613380432129, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_2_new_type.3c72971987", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect new_type\nfrom `gbi-test`.`dbt_prod`.`stg_market_2`\nwhere new_type is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-24T22:11:01.012003Z", "completed_at": "2026-08-24T22:11:01.028318Z"}, {"name": "execute", "started_at": "2026-08-24T22:11:01.035827Z", "completed_at": "2026-08-24T22:11:01.035835Z"}], "thread_id": "Thread-8 (worker)", "execution_time": 0.03977680206298828, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.google_fiber.mart_fiber_fcr", "compiled": true, "compiled_code": "-- models/marts/mart_fiber_fcr.sql\n-- Final mart: Union all markets and calculate FCR metrics\n\nWITH combined AS (\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_1`\n    UNION ALL\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_2`\n    UNION ALL\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_3`\n),\n\n-- DATA-QUALITY GATE: drop rows that cannot produce a FCR value.\n-- In staging, a raw \"null\" in contacts_n is COALESCE'd to 0. For the\n-- follow-up columns 0 = \"no follow-up\" (correct), but for contacts_n\n-- (first contacts = the FCR denominator) a 0 means the first-contact\n-- count is missing/unknown, NOT \"zero contacts\" \u2014 some of those rows\n-- even have follow-up contacts, which is impossible with 0 originals.\n-- SAFE_DIVIDE by a 0 denominator returns NULL, so FCR \"was not\n-- calculated\" for those rows. They are excluded here.\n\nvalid AS (\n    SELECT * FROM combined\n    WHERE contacts_n > 0\n),\n\nwith_metrics AS (\n    SELECT\n        date_created,\n        new_type,\n        new_market,\n        contacts_n,\n        contacts_n_1,\n        contacts_n_2,\n        contacts_n_3,\n        contacts_n_4,\n        contacts_n_5,\n        contacts_n_6,\n        contacts_n_7,\n\n        (contacts_n_1 + contacts_n_2 + contacts_n_3 +\n         contacts_n_4 + contacts_n_5 + contacts_n_6 + contacts_n_7) AS total_repeat_contacts,\n\n        -- Day 1 FCR Rate\n        -- Use GREATEST(..., 0) to clamp repeat contacts that exceed first contacts\n        -- (one case may be re-contacted many times), which would make FCR rate < 0%\n        -- If repeats exceed first contacts that day, FCR is cut to 0% since the issue wasn't resolved.\n\n        SAFE_DIVIDE(\n            GREATEST(contacts_n - contacts_n_1, 0),\n            contacts_n\n        ) AS fcr_day1_rate,\n\n        -- 7-day FCR Rate\n        SAFE_DIVIDE(\n            GREATEST(contacts_n - (contacts_n_1 + contacts_n_2 + contacts_n_3 + \n                                   contacts_n_4 + contacts_n_5 + contacts_n_6 + contacts_n_7), 0),\n            contacts_n\n        ) AS fcr_7day_rate,\n\n        -- Repeat rate per day\n        SAFE_DIVIDE(contacts_n_1, contacts_n) AS repeat_rate_day1,\n        SAFE_DIVIDE(contacts_n_2, contacts_n) AS repeat_rate_day2,\n        SAFE_DIVIDE(contacts_n_3, contacts_n) AS repeat_rate_day3,\n        SAFE_DIVIDE(contacts_n_4, contacts_n) AS repeat_rate_day4,\n        SAFE_DIVIDE(contacts_n_5, contacts_n) AS repeat_rate_day5,\n        SAFE_DIVIDE(contacts_n_6, contacts_n) AS repeat_rate_day6,\n        SAFE_DIVIDE(contacts_n_7, contacts_n) AS repeat_rate_day7,\n\n        -- Metadata\n        CURRENT_TIMESTAMP() AS dbt_updated_at\n\n    FROM valid\n)\n\nSELECT * FROM with_metrics", "relation_name": "`gbi-test`.`dbt_prod`.`mart_fiber_fcr`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-24T22:11:01.015325Z", "completed_at": "2026-08-24T22:11:01.028830Z"}, {"name": "execute", "started_at": "2026-08-24T22:11:01.036419Z", "completed_at": "2026-08-24T22:11:01.036427Z"}], "thread_id": "Thread-9 (worker)", "execution_time": 0.03916525840759277, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.dbt_utils_expression_is_true_stg_market_3_contacts_n___0.07f8f285ec", "compiled": true, "compiled_code": "\n\n\n\nselect\n    1\nfrom `gbi-test`.`dbt_prod`.`stg_market_3`\n\nwhere not(contacts_n >= 0)\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-24T22:11:01.021224Z", "completed_at": "2026-08-24T22:11:01.030395Z"}, {"name": "execute", "started_at": "2026-08-24T22:11:01.041865Z", "completed_at": "2026-08-24T22:11:01.041