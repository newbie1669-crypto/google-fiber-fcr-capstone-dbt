T * FROM `gbi-test`.`dbt_prod`.`stg_market_1`\n    UNION ALL\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_2`\n    UNION ALL\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_3`\n),\n\n-- DATA-QUALITY GATE: drop rows that cannot produce a FCR value.\n-- In staging, a raw \"null\" in contacts_n is COALESCE'd to 0. For the\n-- follow-up columns 0 = \"no follow-up\" (correct), but for contacts_n\n-- (first contacts = the FCR denominator) a 0 means the first-contact\n-- count is missing/unknown, NOT \"zero contacts\" \u2014 some of those rows\n-- even have follow-up contacts, which is impossible with 0 originals.\n-- SAFE_DIVIDE by a 0 denominator returns NULL, so FCR \"was not\n-- calculated\" for those rows. They are excluded here.\n\nvalid AS (\n    SELECT * FROM combined\n    WHERE contacts_n > 0\n),\n\nwith_metrics AS (\n    SELECT\n        date_created,\n        new_type,\n        new_market,\n        contacts_n,\n        contacts_n_1,\n        contacts_n_2,\n        contacts_n_3,\n        contacts_n_4,\n        contacts_n_5,\n        contacts_n_6,\n        contacts_n_7,\n\n        (contacts_n_1 + contacts_n_2 + contacts_n_3 +\n         contacts_n_4 + contacts_n_5 + contacts_n_6 + contacts_n_7) AS total_repeat_contacts,\n\n        -- Day 1 FCR Rate\n        -- Use GREATEST(..., 0) to clamp repeat contacts that exceed first contacts\n        -- (one case may be re-contacted many times), which would make FCR rate < 0%\n        -- If repeats exceed first contacts that day, FCR is cut to 0% since the issue wasn't resolved.\n\n        SAFE_DIVIDE(\n            GREATEST(contacts_n - contacts_n_1, 0),\n            contacts_n\n        ) AS fcr_day1_rate,\n\n        -- 7-day FCR Rate\n        SAFE_DIVIDE(\n            GREATEST(contacts_n - (contacts_n_1 + contacts_n_2 + contacts_n_3 + \n                                   contacts_n_4 + contacts_n_5 + contacts_n_6 + contacts_n_7), 0),\n            contacts_n\n        ) AS fcr_7day_rate,\n\n        -- Repeat rate per day\n        SAFE_DIVIDE(contacts_n_1, contacts_n) AS repeat_rate_day1,\n        SAFE_DIVIDE(contacts_n_2, contacts_n) AS repeat_rate_day2,\n        SAFE_DIVIDE(contacts_n_3, contacts_n) AS repeat_rate_day3,\n        SAFE_DIVIDE(contacts_n_4, contacts_n) AS repeat_rate_day4,\n        SAFE_DIVIDE(contacts_n_5, contacts_n) AS repeat_rate_day5,\n        SAFE_DIVIDE(contacts_n_6, contacts_n) AS repeat_rate_day6,\n        SAFE_DIVIDE(contacts_n_7, contacts_n) AS repeat_rate_day7,\n\n        -- Metadata\n        CURRENT_TIMESTAMP() AS dbt_updated_at\n\n    FROM valid\n)\n\nSELECT * FROM with_metrics", "relation_name": "`gbi-test`.`dbt_prod`.`mart_fiber_fcr`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-15T02:45:03.027660Z", "completed_at": "2026-07-15T02:45:03.040283Z"}, {"name": "execute", "started_at": "2026-07-15T02:45:03.042600Z", "completed_at": "2026-07-15T02:45:03.042605Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 0.026000499725341797, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_2_contacts_n.05421176c1", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect contacts_n\nfrom `gbi-test`.`dbt_prod`.`stg_market_2`\nwhere contacts_n is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-15T02:45:03.030110Z", "completed_at": "2026-07-15T02:45:03.040741Z"}, {"name": "execute", "started_at": "2026-07-15T02:45:03.043000Z", "completed_at": "2026-07-15T02:45:03.043005Z"}], "thread_id": "Thread-8 (worker)", "execution_time": 0.0260922908782959, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_2_date_created.e43a54f190", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect date_created\nfrom `gbi-test`.`dbt_prod`.`stg_market_2`\nwhere date_created is null\n\n\n", "relation_name":