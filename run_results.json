\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-14T14:24:29.632679Z", "completed_at": "2026-07-14T14:24:29.666435Z"}, {"name": "execute", "started_at": "2026-07-14T14:24:29.670202Z", "completed_at": "2026-07-14T14:24:29.670218Z"}], "thread_id": "Thread-9 (worker)", "execution_time": 0.05016160011291504, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_2_new_type.3c72971987", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect new_type\nfrom `gbi-test`.`dbt_prod`.`stg_market_2`\nwhere new_type is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-14T14:24:29.637100Z", "completed_at": "2026-07-14T14:24:29.667243Z"}, {"name": "execute", "started_at": "2026-07-14T14:24:29.671650Z", "completed_at": "2026-07-14T14:24:29.671660Z"}], "thread_id": "Thread-7 (worker)", "execution_time": 0.050997257232666016, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.google_fiber.mart_fiber_fcr", "compiled": true, "compiled_code": "-- models/marts/mart_fiber_fcr.sql\n-- Final mart: Union all markets and calculate FCR metrics\n\nWITH combined AS (\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_1`\n    UNION ALL\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_2`\n    UNION ALL\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_3`\n),\n\n-- DATA-QUALITY GATE: drop rows that cannot produce a FCR value.\n-- In staging, a raw \"null\" in contacts_n is COALESCE'd to 0. For the\n-- follow-up columns 0 = \"no follow-up\" (correct), but for contacts_n\n-- (first contacts = the FCR denominator) a 0 means the first-contact\n-- count is missing/unknown, NOT \"zero contacts\" \u2014 some of those rows\n-- even have follow-up contacts, which is impossible with 0 originals.\n-- SAFE_DIVIDE by a 0 denominator returns NULL, so FCR \"was not\n-- calculated\" for those rows. They are excluded here.\n\nvalid AS (\n    SELECT * FROM combined\n    WHERE contacts_n > 0\n),\n\nwith_metrics AS (\n    SELECT\n        date_created,\n        new_type,\n        new_market,\n        contacts_n,\n        contacts_n_1,\n        contacts_n_2,\n        contacts_n_3,\n        contacts_n_4,\n        contacts_n_5,\n        contacts_n_6,\n        contacts_n_7,\n\n        (contacts_n_1 + contacts_n_2 + contacts_n_3 +\n         contacts_n_4 + contacts_n_5 + contacts_n_6 + contacts_n_7) AS total_repeat_contacts,\n\n        -- Day 1 FCR Rate\n        -- Use GREATEST(..., 0) to clamp repeat contacts that exceed first contacts\n        -- (one case may be re-contacted many times), which would make FCR rate < 0%\n        -- If repeats exceed first contacts that day, FCR is cut to 0% since the issue wasn't resolved.\n\n        SAFE_DIVIDE(\n            GREATEST(contacts_n - contacts_n_1, 0),\n            contacts_n\n        ) AS fcr_day1_rate,\n\n        -- 7-day FCR Rate\n        SAFE_DIVIDE(\n            GREATEST(contacts_n - (contacts_n_1 + contacts_n_2 + contacts_n_3 + \n                                   contacts_n_4 + contacts_n_5 + contacts_n_6 + contacts_n_7), 0),\n            contacts_n\n        ) AS fcr_7day_rate,\n\n        -- Repeat rate per day\n        SAFE_DIVIDE(contacts_n_1, contacts_n) AS repeat_rate_day1,\n        SAFE_DIVIDE(contacts_n_2, contacts_n) AS repeat_rate_day2,\n        SAFE_DIVIDE(contacts_n_3, contacts_n) AS repeat_rate_day3,\n        SAFE_DIVIDE(contacts_n_4, contacts_n) AS repeat_rate_day4,\n        SAFE_DIVIDE(contacts_n_5, contacts_n) AS repeat_rate_day5,\n        SAFE_DIVIDE(contacts_n_6, contacts_n) AS repeat_rate_day6,\n        SAFE_DIVIDE(contacts_n_7, contacts_n) AS repeat_rate_day7,\n\n        -- Metadata\n        CURRENT_TIMESTAMP() AS dbt_updated_at\n\n    FROM valid\n)\n\nSELECT * FROM with_metrics", "relation_name": "`gbi-test`.`dbt_prod`.`mart_fiber_fcr`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-14T14:24:29.627301Z", "completed_at": "2026-07-14T14:24:29.667765Z"}, {"name": "execute", "started_at": "2026-07-14T14:24:29.672911Z", "completed_at": "2026-07-14T14:24:29.672922Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 0.05390000343322754, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_2_new_market.4d0b681bb5", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect new_market\nfrom `gbi-test`.`dbt_prod`.`stg_market_2`\nwhere new_market is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-14T14:24:29.641182Z", "completed_at": "2026-07-14T14:24:29.668305Z"}, {"name": "execute", "started_at": "2026-07-14T14:24:29.673684Z", "completed_at": "2026-07-14T14:24:29.673692Z"}], "thread_id": "Thread-8 (worker)", "execution_time": 0.05251908302307129, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.dbt_utils_expression_is_true_stg_market_1_contacts_n___0.30f91f99d2", "compiled": true, "compiled_code": "\n\n\n\nselect\n    1\nfrom `gbi-test`.`dbt_prod`.`stg_market_1`\n\nwhere not(contacts_n >= 0)\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-14T14:24:29.655158Z", "completed_at": "2026-07-14T14:24:29.669035Z"}, {"name": "execute", "started_at": "2026-07-14T14:24:29.674401Z", "completed_at": "2026-07-14T14:24:29.674408Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 0.05171632766723633, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_1_new_market.819377fe1e", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect new_market\nfrom `gbi-test`.`dbt_prod`.`stg_market_1`\nwhere new_market is null\n\n\n", "relation_name": null,