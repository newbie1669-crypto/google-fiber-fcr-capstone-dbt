{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.11.12", "generated_at": "2026-07-10T21:08:28.965520Z", "invocation_id": "ac2064a5-cab4-4ae3-8118-4e1008200d34", "invocation_started_at": "2026-07-10T21:08:25.055723Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T21:08:28.415892Z", "completed_at": "2026-07-10T21:08:28.572292Z"}, {"name": "execute", "started_at": "2026-07-10T21:08:28.573942Z", "completed_at": "2026-07-10T21:08:28.573963Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.16076350212097168, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.google_fiber.stg_market_1", "compiled": true, "compiled_code": "-- models/staging/stg_market_1.sql\n\nWITH source AS (\n    SELECT * FROM `gbi-test`.`fiber`.`market_1`\n),\n\ncleaned AS (\n    SELECT\n        SAFE_CAST(date_created AS DATE) AS date_created,\n        COALESCE(SAFE_CAST(contacts_n AS INT64), 0) AS contacts_n,\n        COALESCE(SAFE_CAST(contacts_n_1 AS INT64), 0) AS contacts_n_1,\n        COALESCE(SAFE_CAST(contacts_n_2 AS INT64), 0) AS contacts_n_2,\n        COALESCE(SAFE_CAST(contacts_n_3 AS INT64), 0) AS contacts_n_3,\n        COALESCE(SAFE_CAST(contacts_n_4 AS INT64), 0) AS contacts_n_4,\n        COALESCE(SAFE_CAST(contacts_n_5 AS INT64), 0) AS contacts_n_5,\n        COALESCE(SAFE_CAST(contacts_n_6 AS INT64), 0) AS contacts_n_6,\n        COALESCE(SAFE_CAST(contacts_n_7 AS INT64), 0) AS contacts_n_7,\n        TRIM(UPPER(new_type)) AS new_type,\n        TRIM(UPPER(new_market)) AS new_market\n    FROM source\n)\n\nSELECT * FROM cleaned", "relation_name": "`gbi-test`.`dbt_prod`.`stg_market_1`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T21:08:28.425889Z", "completed_at": "2026-07-10T21:08:28.573125Z"}, {"name": "execute", "started_at": "2026-07-10T21:08:28.574674Z", "completed_at": "2026-07-10T21:08:28.574684Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.15968108177185059, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.google_fiber.stg_market_3", "compiled": true, "compiled_code": "-- models/staging/stg_market_3.sql\n\nWITH source AS (\n    SELECT * FROM `gbi-test`.`fiber`.`market_3`\n),\n\ncleaned AS (\n    SELECT\n        SAFE_CAST(date_created AS DATE) AS date_created,\n        COALESCE(SAFE_CAST(contacts_n AS INT64), 0) AS contacts_n,\n        COALESCE(SAFE_CAST(contacts_n_1 AS INT64), 0) AS contacts_n_1,\n        COALESCE(SAFE_CAST(contacts_n_2 AS INT64), 0) AS contacts_n_2,\n        COALESCE(SAFE_CAST(contacts_n_3 AS INT64), 0) AS contacts_n_3,\n        COALESCE(SAFE_CAST(contacts_n_4 AS INT64), 0) AS contacts_n_4,\n        COALESCE(SAFE_CAST(contacts_n_5 AS INT64), 0) AS contacts_n_5,\n        COALESCE(SAFE_CAST(contacts_n_6 AS INT64), 0) AS contacts_n_6,\n        COALESCE(SAFE_CAST(contacts_n_7 AS INT64), 0) AS contacts_n_7,\n        TRIM(UPPER(new_type)) AS new_type,\n        TRIM(UPPER(new_market)) AS new_market\n    FROM source\n)\n\nSELECT * FROM cleaned", "relation_name": "`gbi-test`.`dbt_prod`.`stg_market_3`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T21:08:28.423140Z", "completed_at": "2026-07-10T21:08:28.573545Z"}, {"name": "execute", "started_at": "2026-07-10T21:08:28.575298Z", "completed_at": "2026-07-10T21:08:28.575304Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.1611649990081787, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.google_fiber.stg_market_2", "compiled": true, "compiled_code": "-- models/staging/stg_market_2.sql\n\nWITH source AS (\n    SELECT * FROM `gbi-test`.`fiber`.`market_2`\n),\n\ncleaned AS (\n    SELECT\n        SAFE_CAST(date_created AS DATE) AS date_created,\n        COALESCE(SAFE_CAST(contacts_n AS INT64), 0) AS contacts_n,\n        COALESCE(SAFE_CAST(contacts_n_1 AS INT64), 0) AS contacts_n_1,\n        COALESCE(SAFE_CAST(contacts_n_2 AS INT64), 0) AS contacts_n_2,\n        COALESCE(SAFE_CAST(contacts_n_3 AS INT64), 0) AS contacts_n_3,\n        COALESCE(SAFE_CAST(contacts_n_4 AS INT64), 0) AS contacts_n_4,\n        COALESCE(SAFE_CAST(contacts_n_5 AS INT64), 0) AS contacts_n_5,\n        COALESCE(SAFE_CAST(contacts_n_6 AS INT64), 0) AS contacts_n_6,\n        COALESCE(SAFE_CAST(contacts_n_7 AS INT64), 0) AS contacts_n_7,\n        TRIM(UPPER(new_type)) AS new_type,\n        TRIM(UPPER(new_market)) AS new_market\n    FROM source\n)\n\nSELECT * FROM cleaned", "relation_name": "`gbi-test`.`dbt_prod`.`stg_market_2`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T21:08:28.580107Z", "completed_at": "2026-07-10T21:08:28.591997Z"}, {"name": "execute", "started_at": "2026-07-10T21:08:28.606769Z", "completed_at": "2026-07-10T21:08:28.606782Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 0.029850244522094727, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.google_fiber.mart_fiber_fcr", "compiled": true, "compiled_code": "-- models/marts/mart_fiber_fcr.sql\n-- Final mart: Union all markets and calculate FCR metrics\n\nWITH combined AS (\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_1`\n    UNION ALL\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_2`\n    UNION ALL\n    SELECT * FROM `gbi-test`.`dbt_prod`.`stg_market_3`\n),\n\n-- DATA-QUALITY GATE: drop rows that cannot produce a FCR value.\n-- In staging, a raw \"null\" in contacts_n is COALESCE'd to 0. For the\n-- follow-up columns 0 = \"no follow-up\" (correct), but for contacts_n\n-- (first contacts = the FCR denominator) a 0 means the first-contact\n-- count is missing/unknown, NOT \"zero contacts\" \u2014 some of those rows\n-- even have follow-up contacts, which is impossible with 0 originals.\n-- SAFE_DIVIDE by a 0 denominator returns NULL, so FCR \"was not\n-- calculated\" for those rows. They are excluded here.\n\nvalid AS (\n    SELECT * FROM combined\n    WHERE contacts_n > 0\n),\n\nwith_metrics AS (\n    SELECT\n        date_created,\n        new_type,\n        new_market,\n        contacts_n,\n        contacts_n_1,\n        contacts_n_2,\n        contacts_n_3,\n        contacts_n_4,\n        contacts_n_5,\n        contacts_n_6,\n        contacts_n_7,\n\n        (contacts_n_1 + contacts_n_2 + contacts_n_3 +\n         contacts_n_4 + contacts_n_5 + contacts_n_6 + contacts_n_7) AS total_repeat_contacts,\n\n        -- Day 1 FCR Rate\n        -- Use GREATEST(..., 0) to clamp repeat contacts that exceed first contacts\n        -- (one case may be re-contacted many times), which would make FCR rate < 0%\n        -- If repeats exceed first contacts that day, FCR is cut to 0% since the issue wasn't resolved.\n\n        SAFE_DIVIDE(\n            GREATEST(contacts_n - contacts_n_1, 0),\n            contacts_n\n        ) AS fcr_day1_rate,\n\n        -- 7-day FCR Rate\n        SAFE_DIVIDE(\n            GREATEST(contacts_n - (contacts_n_1 + contacts_n_2 + contacts_n_3 + \n                                   contacts_n_4 + contacts_n_5 + contacts_n_6 + contacts_n_7), 0),\n            contacts_n\n        ) AS fcr_7day_rate,\n\n        -- Repeat rate per day\n        SAFE_DIVIDE(contacts_n_1, contacts_n) AS repeat_rate_day1,\n        SAFE_DIVIDE(contacts_n_2, contacts_n) AS repeat_rate_day2,\n        SAFE_DIVIDE(contacts_n_3, contacts_n) AS repeat_rate_day3,\n        SAFE_DIVIDE(contacts_n_4, contacts_n) AS repeat_rate_day4,\n        SAFE_DIVIDE(contacts_n_5, contacts_n) AS repeat_rate_day5,\n        SAFE_DIVIDE(contacts_n_6, contacts_n) AS repeat_rate_day6,\n        SAFE_DIVIDE(contacts_n_7, contacts_n) AS repeat_rate_day7,\n\n        -- Metadata\n        CURRENT_TIMESTAMP() AS dbt_updated_at\n\n    FROM valid\n)\n\nSELECT * FROM with_metrics", "relation_name": "`gbi-test`.`dbt_prod`.`mart_fiber_fcr`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T21:08:28.592409Z", "completed_at": "2026-07-10T21:08:28.624811Z"}, {"name": "execute", "started_at": "2026-07-10T21:08:28.632940Z", "completed_at": "2026-07-10T21:08:28.632952Z"}], "thread_id": "Thread-7 (worker)", "execution_time": 0.0538783073425293, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.dbt_utils_expression_is_true_stg_market_1_contacts_n___0.30f91f99d2", "compiled": true, "compiled_code": "\n\n\n\nselect\n    1\nfrom `gbi-test`.`dbt_prod`.`stg_market_1`\n\nwhere not(contacts_n >= 0)\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T21:08:28.602514Z", "completed_at": "2026-07-10T21:08:28.630699Z"}, {"name": "execute", "started_at": "2026-07-10T21:08:28.635179Z", "completed_at": "2026-07-10T21:08:28.635186Z"}], "thread_id": "Thread-8 (worker)", "execution_time": 0.05060410499572754, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.dbt_utils_expression_is_true_stg_market_2_contacts_n___0.0b21f12e45", "compiled": true, "compiled_code": "\n\n\n\nselect\n    1\nfrom `gbi-test`.`dbt_prod`.`stg_market_2`\n\nwhere not(contacts_n >= 0)\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-10T21:08:28.613556Z", "completed_at": "2026-07-10T21:08:28.632146Z"}, {"name": "execute", "started_at": "2026-07-10T21:08:28.635778Z", "completed_at": "2026-07-10T21:08:28.635787Z"}], "thread_id": "Thread-9 (worker)", "execution_time": 0.050375938415527344, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.dbt_utils_expression_is_true_stg_market_3_contacts_n___0.07f8f285ec", "compiled": true, "compiled_code": "\n\n\n\nselect\n    1\nfrom `gbi-test`.`dbt_prod`.`stg_market_3`\n\nwhere not(contacts_n >= 0)\n\n", "relation_name": null, "batch_result