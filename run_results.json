_1 AS INT64), 0) AS contacts_n_1,\n        COALESCE(SAFE_CAST(contacts_n_2 AS INT64), 0) AS contacts_n_2,\n        COALESCE(SAFE_CAST(contacts_n_3 AS INT64), 0) AS contacts_n_3,\n        COALESCE(SAFE_CAST(contacts_n_4 AS INT64), 0) AS contacts_n_4,\n        COALESCE(SAFE_CAST(contacts_n_5 AS INT64), 0) AS contacts_n_5,\n        COALESCE(SAFE_CAST(contacts_n_6 AS INT64), 0) AS contacts_n_6,\n        COALESCE(SAFE_CAST(contacts_n_7 AS INT64), 0) AS contacts_n_7,\n        TRIM(UPPER(new_type)) AS new_type,\n        TRIM(UPPER(new_market)) AS new_market\n    FROM source\n)\n\nSELECT * FROM cleaned", "relation_name": "`gbi-test`.`dbt_prod`.`stg_market_3`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-13T12:46:30.806183Z", "completed_at": "2026-07-13T12:46:30.836597Z"}, {"name": "execute", "started_at": "2026-07-13T12:46:30.849268Z", "completed_at": "2026-07-13T12:46:30.849277Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 0.044850826263427734, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.dbt_utils_expression_is_true_stg_market_1_contacts_n___0.30f91f99d2", "compiled": true, "compiled_code": "\n\n\n\nselect\n    1\nfrom `gbi-test`.`dbt_prod`.`stg_market_1`\n\nwhere not(contacts_n >= 0)\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-13T12:46:30.826533Z", "completed_at": "2026-07-13T12:46:30.848084Z"}, {"name": "execute", "started_at": "2026-07-13T12:46:30.860167Z", "completed_at": "2026-07-13T12:46:30.860180Z"}], "thread_id": "Thread-7 (worker)", "execution_time": 0.05249786376953125, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.google_fiber.not_null_stg_market_1_contacts_n.9230153d9e", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect contacts_n\nfrom `gbi-test`.`dbt_prod`.`stg_market_1`\nwhere contacts_n is null\n\n\n", "relation_name"